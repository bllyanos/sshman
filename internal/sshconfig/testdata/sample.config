# managed by hand
Include ~/.ssh/config.d/*

# personal
Host personal-vps
    HostName 203.0.113.10
    User billy
    Port 2222
    IdentityFile ~/.ssh/id_ed25519_personal
    IdentitiesOnly yes

Host work-db work-db-alt
	HostName=10.0.0.5
	User deploy

Host github.com
  HostName github.com
  User git
  IdentityFile "~/.ssh/my key"
  # inline comment kept
  IdentitiesOnly yes

Match host *.internal
    ProxyJump bastion

Host *
    ServerAliveInterval 30
